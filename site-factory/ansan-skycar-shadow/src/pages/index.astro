---
import BaseLayout from '../layouts/BaseLayout.astro';
import pages from '../data/pages.json';
import { realExterior, realIndustrial, realBoom } from '../data/real-photo-assets';
const page = pages.find((p:any)=>p.url==='/')!;
const groups = [
  {label:'가격·견적',links:pages.filter((p:any)=>['pricing','quote'].includes(p.category))},
  {label:'작업유형',links:pages.filter((p:any)=>p.category==='work-types')},
  {label:'지역별 작업',links:pages.filter((p:any)=>p.category==='areas')}
];
const related=(page.relatedKeys||[]).map((key:string)=>(pages as any[]).find(p=>p.pageKey===key)).filter(Boolean);
const smsHref='sms:01053221952?body='+encodeURIComponent('영진스카이 스카이차 견적 문의드립니다. 주소 / 작업종류 / 작업높이 / 현장사진을 보내겠습니다.');
function rich(text:string){
 const out:any[]=[]; const re=/\[\[([^|]+)\|([^\]]+)\]\]/g; let last=0; let m;
 while((m=re.exec(text))){
  if(m.index>last) out.push({text:text.slice(last,m.index)});
  const target=m[1]; const found=(pages as any[]).find(p=>p.pageKey===target);
  out.push({text:m[2],href:target.startsWith('/')?target:(found?.url||'#')});
  last=re.lastIndex;
 }
 if(last<text.length) out.push({text:text.slice(last)});
 return out;
}
---
<BaseLayout title={page.title} description={page.description} canonicalPath="/">
<section class="marketing-hero">
  <a class="marketing-art sf-img-hero-home" href={smsHref} aria-label="영진스카이 문자 견적 문의"><span class="sr-only">안산 스카이차 영진스카이 견적 문의</span></a>
  <div class="hero-actions">
    <a class="btn btn-primary" href="tel:01053221952">☎ 지금 전화하기</a>
    <a class="btn btn-secondary" href={smsHref}>✉ 문자로 견적 문의</a>
    <a class="btn btn-ghost" href="/quote/ansan-skycar-estimate/">견적 준비사항 보기</a>
  </div>
</section>

<section class="trust-strip" aria-label="영진스카이 서비스 안내">
  <div><b>영진스카이</b><span>안산 스카이차</span></div>
  <div><b>당일예약</b><span>및 출동 가능</span></div>
  <div><b>1톤 · 2.5톤</b><span>3톤 · 5톤 출장 가능</span></div>
  <div><b>010-5322-1952</b><span>전화·문자 견적</span></div>
</section>

<section class="intro-panel">
  <div>
    <span class="eyebrow">안산 스카이차 전문 상담</span>
    <h1>{page.h1}</h1>
    <p class="lead">{page.firstAnswer}</p>
  </div>
  <div class="quick-check">
    <strong>빠른 견적을 위해 보내주세요</strong>
    <span>① 주소</span><span>② 작업 종류</span><span>③ 작업 높이</span><span>④ 현장 사진</span>
    <a href={smsHref}>사진 첨부해서 문자 보내기 →</a>
  </div>
</section>

<section class="service-groups">
  {groups.map(g => <article class="service-group"><h2>{g.label}</h2><div class="link-cards">{g.links.map((p:any)=><a class="link-card" href={p.url}><strong>{p.primaryKeyword}</strong><span>{p.cardSummary}</span><em>자세히 보기 →</em></a>)}</div></article>)}
</section>

<section class="split-feature">
  <div class="feature-visual sf-img-work-sign" aria-hidden="true"></div>
  <div class="feature-copy">
    <span class="eyebrow">간판 · 외벽 · 실외기 · CCTV</span>
    <h2>작업 목적을 알려주시면 현장 조건을 빠르게 정리할 수 있습니다</h2>
    <p>상가 간판부터 외벽 보수, 실외기 설치·교체, CCTV 고소작업까지 작업 위치와 차량 접근공간을 함께 확인합니다.</p>
    <div class="button-row"><a class="btn btn-dark" href="/work-types/">작업유형 확인</a><a class="text-link" href="tel:01053221952">전화 상담 010-5322-1952 →</a></div>
  </div>
</section>

{page.sections.slice(0,3).map((s:any)=><section class="section content-section"><h2>{s[0]}</h2><p>{rich(s[1]).map((part:any)=>part.href?<a data-context-link="true" href={part.href}>{part.text}</a>:part.text)}</p></section>)}

<a class="wide-banner sf-img-banner-estimate" href={smsHref} aria-label="영진스카이 사진 보내고 견적 문의"><span class="sr-only">사진 보내고 견적 받기</span></a>

{page.sections.slice(3).map((s:any)=><section class="section content-section"><h2>{s[0]}</h2><p>{rich(s[1]).map((part:any)=>part.href?<a data-context-link="true" href={part.href}>{part.text}</a>:part.text)}</p></section>)}

<section class="real-work">
  <div class="section-heading"><span class="eyebrow">첨부해 주신 실제 현장사진</span><h2>영진스카이 현장 이미지</h2><p>아래 사진은 생성 이미지가 아니라 실제 현장사진입니다.</p></div>
  <div class="photo-grid">
    <figure><img src={realExterior} alt="영진스카이 외벽 고소작업 현장사진" loading="lazy"/><figcaption>외벽·고소작업 현장</figcaption></figure>
    <figure><img src={realIndustrial} alt="영진스카이 산업현장 스카이차 작업사진" loading="lazy"/><figcaption>산업·설비 작업 현장</figcaption></figure>
    <figure><img src={realBoom} alt="영진스카이 스카이차 장비 작업 현장사진" loading="lazy"/><figcaption>스카이차 장비 작업 현장</figcaption></figure>
  </div>
</section>

<section class="section evidence">
  <h2>안산 현장 작업에 참고할 지역정보</h2>
  {page.localEvidence.map((e:any)=><article class="evidence-item" data-local-evidence="true"><p>{e.claim}</p><p class="source"><a href={e.sourceUrl} rel="nofollow">{e.sourceName}</a> · 확인 {e.verifiedAt}</p></article>)}
</section>

<section class="section faq">
  <h2>안산 스카이차 자주 묻는 질문</h2>
  {page.faq.map((item:any)=><div class="faq-item"><h3>{item[0]}</h3><p>{item[1]}</p></div>)}
</section>

<section class="final-cta">
  <div><span class="eyebrow">당일예약 및 출동 가능</span><h2>현장사진과 주소를 보내주시면 상담이 빨라집니다</h2><p>1톤 · 2.5톤 · 3톤 · 5톤 스카이차 출장 상담</p></div>
  <div class="button-row"><a class="btn btn-yellow" href="tel:01053221952">010-5322-1952 전화</a><a class="btn btn-light" href={smsHref}>문자로 견적 문의</a></div>
</section>
</BaseLayout>