---
import BaseLayout from '../../layouts/BaseLayout.astro';
import pages from '../../data/pages.json';
import blueprint from '../../data/blueprint.json';
export function getStaticPaths(){
  const counts=(pages as any[]).filter(p=>p.url!=='/').reduce((m:any,p:any)=>(m[p.category]=(m[p.category]||0)+1,m),{});
  return Object.entries(counts).filter(([,count])=>(count as number)>=2).map(([category])=>({params:{category}}));
}
const { category }=Astro.params;
const items=(pages as any[]).filter(p=>p.category===category);
const def=(blueprint as any).categories[category!];
const titleMap:any={"work-types":"안산 스카이차 작업유형","areas":"안산 지역별 스카이차"};
const h1=titleMap[category!]||def.label;
const visualClass=category==='work-types'?'sf-img-work-sign':'sf-img-work-industrial';
const smsHref='sms:01053221952?body='+encodeURIComponent('영진스카이 스카이차 견적 문의드립니다. 주소 / 작업종류 / 작업높이 / 현장사진을 보내겠습니다.');
---
<BaseLayout title={h1} description={def.description} canonicalPath={`/${category}/`}>
<nav class="breadcrumb" aria-label="breadcrumb"><a href="/">안산 스카이차</a><span>›</span><span>{h1}</span></nav>
<section class="category-hero">
  <div><span class="eyebrow">영진스카이</span><h1>{h1}</h1><p class="lead">{def.description}</p><div class="button-row"><a class="btn btn-primary" href="tel:01053221952">전화 문의</a><a class="btn btn-secondary" href={smsHref}>문자로 견적</a></div></div>
  <a class={"category-visual "+visualClass} href={smsHref} aria-label={h1+" 견적 문의"}><span class="sr-only">{h1} 영진스카이 상담</span></a>
</section>
<section class="link-cards category-cards">{items.map((p:any)=><a class="link-card" href={p.url}><strong>{p.primaryKeyword}</strong><span>{p.cardSummary}</span><em>작업조건 확인 →</em></a>)}</section>
<section class="final-cta"><div><span class="eyebrow">당일예약 및 출동 가능</span><h2>작업 위치와 현장사진을 보내주세요</h2><p>1톤 · 2.5톤 · 3톤 · 5톤 출장 가능 · 010-5322-1952</p></div><div class="button-row"><a class="btn btn-yellow" href="tel:01053221952">전화하기</a><a class="btn btn-light" href={smsHref}>견적 문자</a></div></section>
</BaseLayout>