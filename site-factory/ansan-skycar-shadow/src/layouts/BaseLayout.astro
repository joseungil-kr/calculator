---
import '../styles/global.css';
const { title, description, canonicalPath='/' } = Astro.props;
const revision = import.meta.env.SITE_FACTORY_REVISION || 'shadow';
const canonical = new URL(canonicalPath, 'https://generic-skycar-shadow.joseungil.workers.dev').toString();
---
<!doctype html>
<html lang="ko">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width" />
  <title>{title}</title>
  <meta name="description" content={description} />
  <meta name="robots" content="noindex,follow" />
  <link rel="canonical" href={canonical} />
  <meta name="site-factory-revision" content={revision} />
</head>
<body>
<header class="site-header">
  <a class="brand" href="/">안산 스카이차</a>
  <nav><a href="/pricing/ansan-skycar-price/">가격</a><a href="/quote/ansan-skycar-estimate/">견적</a><a href="/work-types/">작업유형</a><a href="/areas/">지역</a></nav>
</header>
<main><slot /></main>
<footer>안산 스카이차 작업 안내 · 현장 조건에 따라 작업 가능 여부와 견적이 달라질 수 있습니다.</footer>
</body>
</html>
