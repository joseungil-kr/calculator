---
import '../styles/global.css';
import {site,menuGroups} from '../config/site';
import buildRevision from '../data/build-revision.json';
const {title,description,canonicalPath='/',noindex=false,orderUrl=site.orderUrl}=Astro.props;
const canonical=new URL(canonicalPath,site.domain).toString();
const indexable=site.indexable && !noindex;
const revision=buildRevision.revision || 'local';
---
<!doctype html><html lang="ko"><head>
<meta charset="UTF-8"/><meta name="viewport" content="width=device-width,initial-scale=1"/>
<title>{title}</title><meta name="description" content={description}/>
<meta name="robots" content={indexable?'index,follow':'noindex,nofollow,noarchive'}/>
{indexable && <meta name="naver-site-verification" content={site.naverVerification}/>}
<meta name="site-factory-revision" content={revision}/><link rel="canonical" href={canonical}/>
<meta property="og:type" content="website"/><meta property="og:title" content={title}/><meta property="og:description" content={description}/><meta property="og:url" content={canonical}/><meta property="og:locale" content="ko_KR"/>
<meta name="twitter:card" content="summary"/><meta name="twitter:title" content={title}/><meta name="twitter:description" content={description}/>
<meta name="theme-color" content="#3a214f"/>
<script type="application/ld+json" set:html={JSON.stringify({'@context':'https://schema.org','@type':'Florist',name:site.brand,url:site.domain,telephone:site.phone,areaServed:site.region}).replace(/</g, String.fromCharCode(92) + 'u003c')}></script>
</head><body>
<a class="skip-link" href="#main-content">본문 바로가기</a>
<header class="site-header"><div class="header-inner"><a class="brand" href="/"><span class="brand-icon">✿</span><span><b>{site.brand}</b><small>{site.region} 꽃배달</small></span></a>
<nav aria-label="주요 메뉴">{menuGroups.map(g=><a href={g.url}>{g.label}</a>)}</nav><a class="phone" href={site.phoneHref}>☎ {site.phone}</a></div></header>
<script is:inline>
(() => {
  const header = document.querySelector('.site-header');
  if (!header || header.dataset.focusClearanceReady) return;
  header.dataset.focusClearanceReady = 'true';
  const updateHeaderHeight = () => {
    const height = `${header.getBoundingClientRect().height}px`;
    const style = document.documentElement.style;
    if (style.getPropertyValue('--site-header-height') !== height) {
      style.setProperty('--site-header-height', height);
    }
  };
  updateHeaderHeight();
  if ('ResizeObserver' in window) {
    new ResizeObserver(updateHeaderHeight).observe(header, { box: 'border-box' });
  } else {
    window.addEventListener('resize', updateHeaderHeight, { passive: true });
    document.fonts?.ready.then(updateHeaderHeight);
    document.fonts?.addEventListener('loadingdone', updateHeaderHeight);
  }
})();
</script>
<main id="main-content"><slot/></main>
<footer><div><strong>{site.brand} {site.region}</strong><span>{site.orderHours}</span><a href={site.phoneHref}>{site.phone}</a><a href={orderUrl}>온라인 주문</a><small>{site.deliveryNotice}</small></div></footer>
<div class="mobile-bar"><a href={site.phoneHref}>전화주문</a><a href={orderUrl}>온라인 주문</a></div>
</body></html>
