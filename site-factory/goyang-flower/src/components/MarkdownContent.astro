---
import {markdownBlocks} from '../lib/content.mjs';
import InlineText from './InlineText.astro';
import InlineOrderBanner from './InlineOrderBanner.astro';
import {orderBannerBoundary} from '../lib/order-banner.mjs';
const blocks=markdownBlocks(Astro.props.content || '');
const bannerBoundary=Astro.props.showOrderBanner === true ? orderBannerBoundary(blocks) : -1;
---
<div class="content-card markdown-content">{blocks.map((block,index) => <>{index===bannerBoundary && <InlineOrderBanner/>}{block.type === 'h2' ? <h2><InlineText text={block.text}/></h2> : block.type === 'h3' ? <h3><InlineText text={block.text}/></h3> : block.type === 'li' ? <ul><li><InlineText text={block.text}/></li></ul> : <p><InlineText text={block.text}/></p>}</>)}{bannerBoundary===blocks.length && <InlineOrderBanner/>}</div>
