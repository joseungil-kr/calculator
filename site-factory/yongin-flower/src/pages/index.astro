---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import ProductShowcase from '../components/ProductShowcase.astro';
import business from '../data/business-truth.json';
import { siteConfig } from '../config/site';
import architecture from '../data/architecture.json';

const activePageKeys = new Set((architecture.pages || []).filter((page) => page.sitemapIndexable !== false && page.status !== 'merged').map((page) => page.pageKey));
const articles = (await getCollection(
  'articles',
  ({ data }) => (data.draftStatus === 'approved' || data.draftStatus === 'published') && activePageKeys.has(data.pageKey)
)).sort((a, b) => b.data.pageKey.localeCompare(a.data.pageKey, 'ko'));

const categoryCounts = articles.reduce<Record<string, number>>((acc, article) => {
  acc[article.data.category] = (acc[article.data.category] ?? 0) + 1;
  return acc;
}, {});
const hrefFor = (article: (typeof articles)[number]) => `/${article.data.category}/${article.data.slug}/`;
const categoryLabel: Record<string,string> = {
  funeral: '근조·장례', business: '개업·이전', school: '졸업·입학',
  event: '공연·행사', gift: '선물·병문안', order: '주문 안내',
};
const services = [
  { category:'funeral', tag:'근조·장례', title:'용인 장례식장 근조화환', body:'시설별 빈소·주차·수령정보와 주문 전 확인사항을 봅니다.', href:'/funeral/' },
  { category:'business', tag:'개업·이전', title:'용인 개업·이전 축하꽃', body:'매장·사무실·사업장 공간과 거래관계에 맞는 형태를 비교합니다.', href:'/business/' },
  { category:'school', tag:'졸업·입학', title:'용인 대학 졸업·입학 꽃', body:'캠퍼스별 행사·수령·이동 동선을 기준으로 준비합니다.', href:'/school/' },
  { category:'event', tag:'공연·행사', title:'용인 공연·전시·행사 꽃', body:'행사장 담당자, 반입 위치, 설치형·전달형을 구분합니다.', href:'/event/' },
  { category:'gift', tag:'선물·병문안', title:'용인 꽃다발·병문안 꽃', body:'병원·역·기념일처럼 수령과 휴대가 중요한 상황을 다룹니다.', href:'/gift/' },
  { category:'order', tag:'주문 안내', title:'당일·가격·문구·주소', body:'실제 주문 전에 필요한 가격·수령정보·리본문구를 확인합니다.', href:'/order/' },
];
const recent = articles.slice(0, 6);
---
<BaseLayout
  title={`용인 꽃배달 | 근조화환·개업화환·꽃다발 주문 | ${siteConfig.brand}`}
  description="용인 꽃배달을 준비할 때 장례·개업·대학·공연·병문안·당일 주문 상황별로 필요한 정보를 확인하고 꽃다발·꽃바구니·화환을 선택할 수 있습니다."
>
  <section class="hero hero-commerce">
    <div class="container hero-commerce-grid">
      <div class="hero-copy">
        <span class="hero-badge">용인 전 지역 꽃배달</span>
        <h1>용인 <em>꽃배달</em></h1>
        <p class="hero-lead">보내는 장소와 이유가 다르면 준비해야 할 정보도 달라집니다.</p>
        <p class="hero-sub">근조화환·개업축하·졸업식 꽃·행사 꽃·병문안부터 주문정보까지<br />용인의 실제 장소와 상황을 기준으로 안내합니다.</p>
        <div class="hero-actions hero-order-actions">
          <a class="hero-phone" href={business.phoneHref}><span>☎</span><strong>전화주문 {business.phone}</strong><small>{business.phoneOrderHours}</small></a>
          <a class="hero-online" href={business.onlineOrderUrl} rel="noopener"><span>▣</span><strong>온라인 주문</strong><small>24시간 주문 가능</small></a>
        </div>
      </div>
    </div>
  </section>

  <section class="section product-section"><div class="container"><ProductShowcase showHeading={false} /></div></section>

  <section class="section guide-section">
    <div class="container">
      <div class="section-head simple-head">
        <div><h2>용인 꽃배달, 무엇을 보내려는지부터 선택하세요</h2><p class="section-intro">지역명보다 장례·개업·졸업·공연·병문안·주문처럼 실제 목적을 먼저 나눴습니다.</p></div>
      </div>
      <div class="guide-tile-grid">
        {services.map((item, index) => {
          const ready = (categoryCounts[item.category] ?? 0) >= 1;
          return ready ? (
            <a class:list={['guide-tile', `guide-tile-${index + 1}`]} href={item.href}>
              <span>{item.tag}</span><h3>{item.title}</h3><p>{item.body}</p><b>자세히 보기 ›</b>
            </a>
          ) : (
            <div class:list={['guide-tile', `guide-tile-${index + 1}`]} aria-label={item.title}>
              <span>{item.tag}</span><h3>{item.title}</h3><p>{item.body}</p>
            </div>
          );
        })}
      </div>
    </div>
  </section>

  <section class="info-band">
    <div class="container info-band-grid">
      <div><strong>용인 생활권</strong><span>처인구 · 기흥구 · 수지구의 목적지와 수령 상황을 구분합니다.</span></div>
      <div><strong>사실 확인</strong><span>병원·장례식장·대학·공연장은 최신 공식 안내를 우선 확인합니다.</span></div>
      <div><strong>주문 정보</strong><span>가격·배송비·주문시간은 저장된 Business Truth 범위에서만 안내합니다.</span></div>
      <div><strong>페이지 원칙</strong><span>한 페이지는 하나의 핵심 검색의도만 담당합니다.</span></div>
    </div>
  </section>

  {recent.length > 0 && (
    <section class="section recent-section">
      <div class="container">
        <div class="section-head simple-head"><div><h2>최근 확인된 용인 꽃배달 가이드</h2><p class="section-intro">공식 정보와 확인일을 기록한 문서만 연결합니다.</p></div></div>
        <div class="grid grid-3">
          {recent.map((article) => (
            <a class="card recent-card" href={hrefFor(article)}>
              <div><span class="tag">{categoryLabel[article.data.category]}</span><h3>{article.data.title}</h3><p>{article.data.description}</p></div>
              <span class="more">가이드 읽기 ›</span>
            </a>
          ))}
        </div>
      </div>
    </section>
  )}
</BaseLayout>
