---
import BaseLayout from '../layouts/BaseLayout.astro';
import { siteConfig } from '../config/site';
---
<BaseLayout
  title={`페이지를 찾을 수 없습니다 | ${siteConfig.brand}`}
  description={`요청한 페이지를 찾을 수 없습니다. ${siteConfig.region} 꽃배달 홈에서 필요한 정보를 다시 확인하세요.`}
  robotsOverride="noindex,nofollow,noarchive"
>
  <section class="page-hero">
    <div class="container">
      <span class="eyebrow">404</span>
      <h1>페이지를 찾을 수 없습니다.</h1>
      <p>주소가 변경되었거나 공개되지 않은 페이지입니다.</p>
      <div class="hero-actions">
        <a class="btn btn-primary" href="/">용인 꽃배달 홈으로 이동</a>
      </div>
    </div>
  </section>
</BaseLayout>
