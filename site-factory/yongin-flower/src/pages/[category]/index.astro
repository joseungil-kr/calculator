---
import { getCollection } from 'astro:content';
import HubIndex from '../../components/HubIndex.astro';
import { siteConfig } from '../../config/site';

type Category = 'funeral' | 'business' | 'school' | 'event' | 'gift' | 'order';

const definitions = {
  funeral: {
    eyebrow: '근조·장례',
    title: `${siteConfig.region} 장례식장 근조화환 안내`,
    intro: '장례식장별 빈소·전화·주차·수령정보와 근조화환 주문 전 확인사항을 정리합니다.',
    description: `${siteConfig.region} 장례식장 근조화환 주문에 필요한 시설·빈소·주차·수령 정보를 안내합니다.`,
  },
  business: {
    eyebrow: '개업·이전',
    title: `${siteConfig.region} 개업·이전 축하꽃 안내`,
    intro: '매장·사무실·사업장의 공간과 거래관계에 맞춰 축하화환·화분·꽃바구니를 고르는 기준을 정리합니다.',
    description: `${siteConfig.region} 개업·이전 축하꽃을 공간, 수령동선, 보내는 사람 관계에 맞춰 안내합니다.`,
  },
  school: {
    eyebrow: '졸업·입학',
    title: `${siteConfig.region} 대학 졸업·입학 꽃 안내`,
    intro: '대학별 행사 일정, 캠퍼스 수령동선, 사진 촬영과 이동을 고려한 꽃 선택 기준을 정리합니다.',
    description: `${siteConfig.region} 대학 졸업·입학 시즌 꽃다발·꽃바구니와 수령 준비 정보를 안내합니다.`,
  },
  event: {
    eyebrow: '공연·행사',
    title: `${siteConfig.region} 공연·전시·행사 축하꽃 안내`,
    intro: '공연장·전시장·행사장에서 설치형과 전달형 꽃을 구분하고 담당자·반입 위치를 확인하는 방법을 정리합니다.',
    description: `${siteConfig.region} 공연·전시·행사장 축하꽃의 수령·설치·반입 확인사항을 안내합니다.`,
  },
  gift: {
    eyebrow: '선물·병문안',
    title: `${siteConfig.region} 꽃다발·병문안·기념일 꽃 안내`,
    intro: '병원, 역, 약속 장소, 기념일처럼 직접 전달과 수령방식이 중요한 상황의 선택 기준을 정리합니다.',
    description: `${siteConfig.region} 병문안·기념일·꽃다발 선물의 수령과 이동, 형태 선택 기준을 안내합니다.`,
  },
  order: {
    eyebrow: '주문 안내',
    title: `${siteConfig.region} 꽃배달 주문·가격·문구 안내`,
    intro: '당일 주문, 가격, 주소, 수령자, 리본문구처럼 주문 직전에 필요한 실무 정보를 정리합니다.',
    description: `${siteConfig.region} 꽃배달 주문 전 가격·문구·주소·수령정보·당일 가능 여부 확인사항을 안내합니다.`,
  },
} as const;

export async function getStaticPaths() {
  const allowed = new Set(['funeral', 'business', 'school', 'event', 'gift', 'order']);
  const articles = await getCollection('articles', ({ data }) => data.draftStatus === 'approved' || data.draftStatus === 'published');
  const categories = [...new Set(articles.map((article) => article.data.category))].filter((category) => allowed.has(category));
  return categories.map((category) => ({ params: { category } }));
}

const category = Astro.params.category as Category;
const definition = definitions[category];
if (!definition) throw new Error(`UNKNOWN_V2_HUB: ${category}`);
---
<HubIndex category={category} {...definition} />
