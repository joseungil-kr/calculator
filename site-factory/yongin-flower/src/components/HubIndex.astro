---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import { siteConfig } from '../config/site';
import architecture from '../data/architecture.json';

type Category = 'funeral' | 'business' | 'school' | 'event' | 'gift' | 'order';
interface Props {
  category: Category;
  eyebrow: string;
  title: string;
  intro: string;
  description: string;
}
const { category, eyebrow, title, intro, description } = Astro.props;
const activePageKeys = new Set((architecture.pages || []).filter((page) => page.sitemapIndexable !== false && page.status !== 'merged').map((page) => page.pageKey));
const roleByPageKey = new Map((architecture.pages || []).map((page) => [page.pageKey, page.pageRole]));

const articles = (await getCollection(
  'articles',
  ({ data }) =>
    (data.draftStatus === 'approved' || data.draftStatus === 'published') &&
    data.category === category &&
    activePageKeys.has(data.pageKey)
)).sort((a, b) => a.data.pageKey.localeCompare(b.data.pageKey, 'ko'));

if (articles.length === 0) throw new Error(`PUBLIC_HUB_EMPTY: /${category}/ has no approved or published content.`);
const hubIndexable = siteConfig.indexable && articles.length >= 3;
const hrefFor = (article: (typeof articles)[number]) => `/${article.data.category}/${article.data.slug}/`;
const roleLabel: Record<string,string> = {
  PLACE_LANDING: '장소 안내',
  INTENT_LANDING: '목적 안내',
  PRICE_GUIDE: '가격 안내',
  INFORMATION_GUIDE: '정보 가이드',
};
---
<BaseLayout
  title={`${title} | ${siteConfig.brand}`}
  description={description}
  robotsOverride={hubIndexable ? undefined : 'noindex,follow,max-image-preview:large'}
>
  <section class="page-hero">
    <div class="container">
      <span class="eyebrow">{eyebrow}</span>
      <h1>{title}</h1>
      <p>{intro}</p>
    </div>
  </section>
  <section class="section">
    <div class="container">
      <div class="hub-card-grid">
        {articles.map((article) => (
          <a class="hub-card" href={hrefFor(article)}>
            <div class="hub-card-top">
              <span class="tag">{roleLabel[roleByPageKey.get(article.data.pageKey) ?? ''] ?? '가이드'}</span>
              <span class="hub-card-region">{article.data.region}</span>
            </div>
            <h2>{article.data.title}</h2>
            <p>{article.data.cardSummary || article.data.description}</p>
            <span class="more">자세히 보기 →</span>
          </a>
        ))}
      </div>
    </div>
  </section>
</BaseLayout>
