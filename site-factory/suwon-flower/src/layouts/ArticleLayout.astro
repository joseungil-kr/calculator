---
import BaseLayout from './BaseLayout.astro';
import ProductShowcase from '../components/ProductShowcase.astro';
import OrderCTA from '../components/OrderCTA.astro';
import { siteConfig } from '../config/site';
import '../styles/article.css';

interface Props {
  title: string;
  description: string;
  category: string;
  structureType: string;
  region: string;
  snapshotId: string;
  slug: string;
  routeType: 'top_level' | 'category';
  sourceUrls?: string[];
  verifiedAt?: Date;
  publishedAt?: Date;
  updatedAt?: Date;
  ogImage?: string;
  ogImageAlt?: string;
}

const {
  title,
  description,
  category,
  structureType,
  region,
  snapshotId,
  slug,
  routeType,
  sourceUrls = [],
  verifiedAt,
  publishedAt,
  updatedAt,
  ogImage,
  ogImageAlt,
} = Astro.props;

const categoryLabel: Record<string, string> = {
  guide: '꽃 선택 가이드',
  places: '장소별',
  occasions: '상황별',
  'flower-knowledge': '꽃 이야기',
  'order-help': '주문 준비',
};

const categoryHref = `/${category}/`;
const isPrimaryLanding = routeType === 'top_level' && slug === siteConfig.primaryLandingSlug;
const displayTitle = isPrimaryLanding ? `${siteConfig.region} 꽃배달, 무엇부터 정하면 될까요?` : title;
const seoTitle = isPrimaryLanding
  ? `${siteConfig.region} 꽃배달·화환 가격 | 전화주문 1844-0644 | ${siteConfig.brand}`
  : `${title} | ${siteConfig.brand}`;

const webPageSchema = {
  '@context': 'https://schema.org',
  '@type': 'WebPage',
  name: displayTitle,
  description,
  inLanguage: 'ko-KR',
  about: [region, '꽃배달', categoryLabel[category] ?? category],
  datePublished: publishedAt?.toISOString(),
  dateModified: (updatedAt ?? verifiedAt)?.toISOString(),
  isPartOf: {
    '@type': 'WebSite',
    name: siteConfig.brand,
    url: Astro.site?.toString() ?? Astro.url.origin,
  },
};

const breadcrumbSchema = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    {
      '@type': 'ListItem',
      position: 1,
      name: '홈',
      item: new URL('/', Astro.site ?? Astro.url.origin).toString(),
    },
    {
      '@type': 'ListItem',
      position: 2,
      name: categoryLabel[category] ?? category,
      item: new URL(categoryHref, Astro.site ?? Astro.url.origin).toString(),
    },
    {
      '@type': 'ListItem',
      position: 3,
      name: displayTitle,
      item: Astro.url.toString(),
    },
  ],
};
---
<BaseLayout
  title={seoTitle}
  description={description}
  ogType="article"
  ogImage={ogImage}
  ogImageAlt={ogImageAlt}
>
  <script type="application/ld+json" set:html={JSON.stringify(webPageSchema)} />
  <script type="application/ld+json" set:html={JSON.stringify(breadcrumbSchema)} />

  <section class:list={['article-shell', isPrimaryLanding && 'primary-landing']} data-snapshot-id={snapshotId}>
    <div class="container">
      <nav class="breadcrumbs" aria-label="Breadcrumb">
        <a href="/">홈</a><span>›</span>
        <a href={categoryHref}>{categoryLabel[category] ?? category}</a><span>›</span>
        <span>현재 글</span>
      </nav>

      <header class="article-header">
        <span class="eyebrow">{isPrimaryLanding ? `${siteConfig.region} 꽃배달 핵심 가이드` : categoryLabel[category] ?? category}</span>
        <h1>{displayTitle}</h1>
        <p>{description}</p>
        <div class="article-meta">
          <span>{region}</span>
          <span>{categoryLabel[category] ?? category}</span>
          {verifiedAt && <span>자료 확인 {verifiedAt.toISOString().slice(0, 10)}</span>}
        </div>
      </header>

      {isPrimaryLanding && (
        <>
          <OrderCTA heading={`${siteConfig.region} 꽃배달 주문 안내`} />
          <div class="landing-quick" aria-label={`${siteConfig.region} 꽃배달 빠른 탐색`}>
            <a href="/places/">
              <span>01</span>
              <strong>장소가 정해졌다면</strong>
              <small>대학·병원·역·동네별로 먼저 확인할 조건을 봅니다.</small>
            </a>
            <a href="/occasions/">
              <span>02</span>
              <strong>보내는 이유가 정해졌다면</strong>
              <small>졸업·개업·행사·이전처럼 상황별 기준을 비교합니다.</small>
            </a>
            <a href="/order-help/">
              <span>03</span>
              <strong>주문 직전이라면</strong>
              <small>수령 장소·시간·문구처럼 빠뜨리기 쉬운 정보를 확인합니다.</small>
            </a>
          </div>
          <ProductShowcase />
        </>
      )}

      <div class="article-grid">
        <article class="prose">
          <slot />
          {sourceUrls.length > 0 && (
            <section class="source-list" aria-labelledby="source-title">
              <h2 id="source-title">자료 확인</h2>
              <ul>
                {sourceUrls.map((url) => <li><a href={url} rel="nofollow noopener noreferrer">{url}</a></li>)}
              </ul>
            </section>
          )}
        </article>

        <aside class="article-aside" aria-label="관련 안내">
          <div class="aside-card">
            <strong>이 글의 역할</strong>
            <p>{isPrimaryLanding ? `${siteConfig.region} 꽃배달 전체 가이드의 출발점입니다. 상황을 좁힌 뒤 상세 문서로 이동하세요.` : '한 가지 질문에 집중해 선택 기준을 정리한 문서입니다.'}</p>
          </div>
          <div class="aside-card">
            <strong>더 구체적으로 찾기</strong>
            <p>장소나 행사 유형이 정해졌다면 해당 허브에서 더 구체적인 글을 확인하세요.</p>
            <a href={categoryHref}>관련 가이드 보기 →</a>
          </div>
        </aside>
      </div>
    </div>
  </section>
</BaseLayout>
