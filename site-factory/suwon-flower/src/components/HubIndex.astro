---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import { siteConfig } from '../config/site';

interface Props {
  category: 'guide' | 'places' | 'occasions' | 'flower-knowledge' | 'order-help';
  eyebrow: string;
  title: string;
  intro: string;
  description: string;
  emptyText?: string;
}

const { category, eyebrow, title, intro, description } = Astro.props;

const articles = (await getCollection(
  'articles',
  ({ data }) =>
    (data.draftStatus === 'approved' || data.draftStatus === 'published') &&
    data.category === category
)).sort((a, b) => a.data.pageKey.localeCompare(b.data.pageKey, 'ko'));

const hrefFor = (article: (typeof articles)[number]) =>
  article.data.routeType === 'top_level'
    ? `/${article.data.slug}/`
    : `/${article.data.category}/${article.data.slug}/`;

const structureLabel: Record<string, string> = {
  hub_overview: '전체 가이드',
  decision_tree: '선택 가이드',
  checklist: '체크리스트',
  etiquette_guide: '문구·예절',
  seasonal_guide: '계절 가이드',
  scenario_based: '상황별',
  recipient_based: '대상별',
  comparison: '비교',
  risk_based: '주의사항',
  route_based: '이동·동선',
  timing_guide: '시간 계획',
  space_based_event: '행사 공간',
  faq_first: '질문 정리',
  care_guide: '관리',
  message_guide: '문구',
  product_form_comparison: '형태 비교',
  myth_busting: '오해 정리',
  relationship_based_b2b: '기업 관계',
};

const fallback: Record<Props['category'], Array<{tag:string; title:string; body:string; href:string}>> = {
  guide: [
    { tag: '전체 기준', title: `${siteConfig.region} 꽃배달을 처음 준비한다면`, body: '받는 사람, 상황, 장소, 전달 방법을 먼저 정하면 상품 선택이 단순해집니다.', href: '/guide/' },
    { tag: '주문 준비', title: '급한 주문 전에 확인할 정보', body: '수령 장소와 시간, 보내는 사람 표기, 문구처럼 주문 전에 정할 항목을 확인합니다.', href: '/order-help/' },
    { tag: '장소', title: '학교·병원·행사장처럼 장소가 정해졌다면', body: '장소마다 먼저 확인해야 할 질문을 장소별 가이드에서 찾아볼 수 있습니다.', href: '/places/' },
  ],
  places: [
    { tag: '학교·대학', title: '학교 행사에서 먼저 볼 것', body: '행사 일정과 전달 동선, 수령 방식은 해당 기관의 최신 안내를 먼저 확인합니다.', href: '/guide/' },
    { tag: '병원', title: '병문안 꽃은 반입 여부부터', body: '향이나 크기를 고르기 전에 면회·물품 반입 관련 최신 안내를 확인하는 편이 안전합니다.', href: '/order-help/' },
    { tag: '행사장', title: '야외·실내 행사 꽃의 차이', body: '설치 공간, 이동, 햇빛과 바람, 사진 동선을 먼저 생각하면 형태를 고르기 쉽습니다.', href: '/guide/' },
  ],
  occasions: [
    { tag: '축하·위로', title: '문구가 먼저 고민된다면', body: '개업·이전·승진·조문처럼 상황과 관계에 맞는 표현을 먼저 정리해 보세요.', href: '/guide/' },
    { tag: '계절', title: '계절과 이동환경을 함께 보기', body: '특정 꽃을 고정하기보다 이동시간, 실내외 환경, 수분관리와 행사 성격을 함께 봅니다.', href: '/guide/' },
    { tag: '형태', title: '꽃다발·꽃바구니·화환 중 고르기', body: '받는 사람과 행사 성격, 전달 방법, 공간과 격식을 순서대로 판단합니다.', href: '/guide/' },
  ],
  'flower-knowledge': [
    { tag: '계절·관리', title: '계절이 바뀌면 관리 기준도 달라집니다', body: '날씨 자체보다 이동시간, 실내외 변화, 수분관리와 보관환경을 함께 확인합니다.', href: '/guide/' },
    { tag: '형태 비교', title: '예쁜 것보다 사용 장면으로 고르기', body: '직접 들고 이동하는지, 한곳에 놓는지, 설치가 필요한지에 따라 적합한 형태가 달라집니다.', href: '/guide/' },
    { tag: '주문 전', title: '상품보다 먼저 정할 정보', body: '수령 장소와 시간, 받는 사람, 보내는 사람 표기를 정하면 선택과 주문이 쉬워집니다.', href: '/order-help/' },
  ],
  'order-help': [
    { tag: '체크리스트', title: '당일 주문 전 7가지', body: '급한 주문일수록 수령 장소, 시간, 연락처, 문구와 발신자 정보를 먼저 준비합니다.', href: '/order-help/' },
    { tag: '문구·예절', title: '축하와 위로 문구 정하기', body: '상황, 보내는 주체, 관계와 격식 수준을 순서대로 정하면 문구 선택이 쉬워집니다.', href: '/guide/' },
    { tag: '전체 가이드', title: `${siteConfig.region} 꽃배달 전체 기준 보기`, body: '무엇을 먼저 정해야 할지 모르겠다면 전체 허브에서 상황별 시작점을 확인합니다.', href: '/guide/' },
  ],
};

const fallbackCards = fallback[category];
---
<BaseLayout title={`${title} | ${siteConfig.brand}`} description={description}>
  <section class="page-hero">
    <div class="container">
      <span class="eyebrow">{eyebrow}</span>
      <h1>{title}</h1>
      <p>{intro}</p>
    </div>
  </section>

  <section class="section">
    <div class="container">
      {articles.length > 0 ? (
        <div class="hub-card-grid">
          {articles.map((article) => (
            <a class="hub-card" href={hrefFor(article)}>
              <div class="hub-card-top">
                <span class="tag">{structureLabel[article.data.structureType] ?? '가이드'}</span>
                <span class="hub-card-region">{article.data.region}</span>
              </div>
              <h2>{article.data.title}</h2>
              <p>{article.data.description}</p>
              <span class="more">자세히 보기 →</span>
            </a>
          ))}
        </div>
      ) : (
        <>
          <div class="hub-empty-intro">
            <strong>이 주제에서 먼저 확인할 기준</strong>
            <p>상세 문서 수가 아직 적더라도 메뉴가 빈 화면이 되지 않도록, 지금 바로 사용할 수 있는 관련 기준과 연결 문서를 제공합니다.</p>
          </div>
          <div class="hub-card-grid">
            {fallbackCards.map((item) => (
              <a class="hub-card" href={item.href}>
                <div class="hub-card-top"><span class="tag">{item.tag}</span></div>
                <h2>{item.title}</h2>
                <p>{item.body}</p>
                <span class="more">관련 가이드 보기 →</span>
              </a>
            ))}
          </div>
        </>
      )}
    </div>
  </section>
</BaseLayout>
