---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import ProductShowcase from '../components/ProductShowcase.astro';
import business from '../data/business-truth.json';

const articles=(await getCollection('articles')).sort((a,b)=>a.data.pageKey.localeCompare(b.data.pageKey,'ko'));
const cats=[
 ['funeral','근조·장례','장례식장·빈소·상주·리본문구와 근조화환 가격'],
 ['business','개업·이전','매장·사무실의 공간과 수령방식에 맞춘 축하화환'],
 ['school','졸업·입학','수원의 대학·학교 행사에서 꽃을 전달하는 방법'],
 ['event','공연·행사','공연·전시·문화행사의 행사명·담당자·수령정보'],
 ['gift','선물·병문안','병원·수원역·광교·행궁동의 꽃 선물 상황'],
 ['order','가격·주문','화환 가격·당일 주문·문구·주소·주문방법']
];
---
<BaseLayout title="수원 꽃배달 | 근조·축하화환·꽃다발 주문 | 꽃이랑 수원" description="수원 꽃배달, 근조화환·개업화환·졸업식 꽃·행사 축하꽃·병문안 꽃과 실제 화환 가격, 전화·온라인 주문방법을 안내합니다.">
<section class="v12-hero">
  <div class="container v12-hero-grid">
    <div>
      <span class="hero-badge">근조 · 축하 · 꽃다발</span>
      <h1>수원 <em>꽃배달</em></h1>
      <p class="hero-lead">보낼 장소와 목적을 알려주시면 상품·가격·수령정보를 함께 확인할 수 있습니다.</p>
      <div class="hero-order-actions">
        <a class="hero-phone" href={business.phoneHref}><strong>전화주문 {business.phone}</strong><small>{business.phoneOrderHours}</small></a>
        <a class="hero-online" href={business.onlineOrderUrl} rel="noopener"><strong>온라인 주문</strong><small>24시간 접수</small></a>
      </div>
      <p class="hero-note">당일 배송 가능 여부와 지역별 추가배송비는 실제 주문 시 확인합니다.</p>
    </div>
    <picture class="v12-hero-picture"><img src="/images/suwon/hero-B-original.png" alt="꽃배달을 표현한 핑크 계열 꽃다발" width="1900" height="800"/></picture>
  </div>
</section>

<section class="section product-section"><div class="container"><ProductShowcase showHeading={true}/></div></section>

<section class="section"><div class="container">
  <div class="section-head"><div><h2>어떤 꽃을 보내시나요?</h2><p class="section-intro">장소보다 먼저 실제 목적을 선택하면 필요한 정보를 빠르게 찾을 수 있습니다.</p></div></div>
  <div class="guide-tile-grid">{cats.map(([cat,title,body])=><a class="guide-tile" href={`/${cat}/`}><span>수원 꽃배달</span><h3>{title}</h3><p>{body}</p><b>확인하기 ›</b></a>)}</div>
</div></section>

<section class="info-band"><div class="container info-band-grid">
  <div><strong>전화주문</strong><span>1844-0644 · 08:00~23:00</span></div>
  <div><strong>온라인 주문</strong><span>24시간 접수</span></div>
  <div><strong>화환 가격</strong><span>근조·축하 3단 59,000원부터</span></div>
  <div><strong>배송 확인</strong><span>추가배송비·당일 가능 여부는 주문 시 확인</span></div>
</div></section>

<section class="section"><div class="container">
  <div class="section-head"><div><h2>수원 꽃배달에서 많이 찾는 내용</h2><p class="section-intro">실제 장소와 구매상황별로 필요한 내용을 바로 확인하세요.</p></div></div>
  <div class="grid grid-3">{articles.slice(0,12).map(a=><a class="card recent-card" href={`/${a.data.category}/${a.data.slug}/`}><div><span class="tag">수원</span><h3>{a.data.title}</h3><p>{a.data.cardSummary}</p></div><span class="more">자세히 보기 ›</span></a>)}</div>
</div></section>
</BaseLayout>