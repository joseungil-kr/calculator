---
import BaseLayout from '../layouts/BaseLayout.astro';
import {site,groups} from '../config/site';
import ProductCards from '../components/ProductCards.astro';
import pages from '../data/pages.json';
import products from '../data/products.json';
import {homeProducts} from '../lib/catalog.mjs';
import {hubGuides} from '../lib/hubs.mjs';
const featured=homeProducts(products);
const heroProducts=['bouquet-happiness','basket-sunshine','funeral-basic','congrats-basic'].map(key=>products.find(p=>p.key===key)).filter(Boolean);
---
<BaseLayout title="수원 꽃배달 | 근조·축하화환·꽃선물 꽃이랑" description="수원 꽃배달 꽃이랑. 꽃다발 50,000원부터, 꽃바구니 65,000원, 근조·축하 기본 3단 화환 59,000원. 전화 1844-0644와 온라인으로 졸업·공연·기념일·개업·장례식장 목적에 맞는 꽃을 주문하세요." canonicalPath="/">
<section class="home-hero">
 <div class="hero-copy"><span class="eyebrow">수원 꽃배달 · 꽃이랑</span><h1>수원 꽃배달,<br/>전할 마음에 맞게 고르세요</h1><p>졸업·공연·기념일에 건네는 꽃다발은 50,000원부터, 꽃바구니 햇살 한가득은 65,000원. 장례식장과 개업·행사에 보내는 기본 3단 화환은 59,000원입니다. 목적과 수령장소를 정한 뒤 상품을 비교해 보세요.</p>
 <div class="actions"><a class="btn primary" href={site.phoneHref}>☎ 1844-0644 전화주문</a><a class="btn dark" href={site.orderUrl}>온라인 주문</a></div>
 <div class="facts"><span>전화 08:00~23:00</span><span>온라인 24시간 접수</span><span>배송지역·추가비용 확인</span></div></div>
 <div class="hero-products" aria-label="꽃다발·꽃바구니·화환 상품">{heroProducts.map((p:any)=><a class="hero-product" href={p.orderUrl} data-product-family={p.family} data-product-key={p.key}><img src={p.img} alt={p.name} loading="eager" width="420" height="420"/><span>{p.name}<strong>{p.price.toLocaleString()}원</strong></span></a>)}</div>
</section>
<section class="purpose-navigation" data-purpose-navigation><div class="section-title"><span class="eyebrow">목적에 맞게 선택</span><h2>누구에게, 어디로 보내시나요?</h2></div><div class="purpose-grid">{groups.map(g=><a class="page-card purpose-card" href={g.url}><strong>{g.label}</strong><span>{hubGuides[g.cat].decision[0]}</span><em>상품·주문 준비 보기 →</em></a>)}</div></section>
<section class="product-section" data-home-selection><div class="section-title"><span class="eyebrow">꽃이랑 상품과 가격</span><h2>꽃다발·꽃바구니·화환을 비교하세요</h2><p>직접 건넬 꽃과 한곳에 둘 꽃은 크기와 형태가 다릅니다. 상품 이미지는 대표 구성이며 지역·계절에 따라 달라질 수 있습니다.</p></div>
<ProductCards products={featured}/></section>
<section class="hub-overview"><div class="section-title"><span class="eyebrow">장소와 상황별 상세 안내</span><h2>전달할 곳에 필요한 정보를 확인하세요</h2></div>
{groups.map(g=><article class="hub-block"><div class="hub-heading"><h3>{g.label}</h3><a href={g.url}>전체 보기 →</a></div><div class="card-grid">{pages.filter((p:any)=>p.category===g.cat).map((p:any)=><a class="page-card" href={p.url}><strong>{p.primaryKeyword}</strong><span>{p.cardSummary}</span></a>)}</div></article>)}</section>
<section class="conversion-panel"><div><span class="eyebrow">주문 전에 준비하면 빨라집니다</span><h2>상품 · 주소 · 수령자 · 문구</h2><p>장례식장은 빈소·상주 정보를, 행사장은 행사명·홀·담당자를 함께 알려주세요.</p></div><div class="actions"><a class="btn light" href={site.phoneHref}>전화주문</a><a class="btn yellow" href={site.orderUrl}>온라인 주문</a></div></section>
</BaseLayout>
