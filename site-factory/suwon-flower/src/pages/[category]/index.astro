---
import BaseLayout from '../../layouts/BaseLayout.astro';
import pages from '../../data/pages.json';
import {site} from '../../config/site';
const labels={funeral:'근조·장례',business:'개업·이전',school:'졸업·학교',event:'공연·행사',gift:'선물·병문안',order:'가격·주문'};
export function getStaticPaths(){return Object.keys(labels).map(category=>({params:{category}}));}
const {category}=Astro.params; const items=(pages as any[]).filter(p=>p.category===category); const label=labels[category!];
---
<BaseLayout title={'수원 '+label+' 꽃배달 | 꽃이랑'} description={'수원 '+label+' 꽃배달 관련 장소·상황별 주문정보를 확인하세요.'} canonicalPath={'/'+category+'/'}>
<nav class="breadcrumb"><a href="/">수원 꽃배달</a><span>›</span><span>{label}</span></nav>
<section class="category-hero"><div><span class="eyebrow">꽃이랑 수원</span><h1>수원 {label} 꽃배달</h1><p>목적과 수령장소에 맞는 주문정보를 선택하세요. 실제 가격과 전화·온라인 주문으로 바로 이어집니다.</p><div class="actions"><a class="btn primary" href={site.phoneHref}>전화주문</a><a class="btn dark" href={site.orderUrl}>온라인 주문</a></div></div></section>
<section class="card-grid big">{items.map((p:any)=><a class="page-card" href={p.url}><strong>{p.primaryKeyword}</strong><span>{p.cardSummary}</span><em>자세히 보기 →</em></a>)}</section>
</BaseLayout>