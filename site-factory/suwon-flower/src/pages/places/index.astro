---
import HubIndex from '../../components/HubIndex.astro';
import { siteConfig } from '../../config/site';
---
<HubIndex
  category="places"
  eyebrow="Places"
  title={`${siteConfig.region} 장소별 가이드`}
  intro="지역명을 붙이는 데서 끝내지 않고, 대학·병원·역·광장·동네처럼 실제 장소에서 먼저 확인할 질문을 정리합니다."
  description={`대학, 병원, 역, 광장, 동네처럼 ${siteConfig.region}의 장소 특성에 맞춰 꽃 선택 기준을 안내합니다.`}
/>
