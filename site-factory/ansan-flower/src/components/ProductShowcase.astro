---
import { loadSiteProducts } from '../lib/site-catalog.mjs';
import business from '../data/business-truth.json';
import { siteConfig } from '../config/site';

type Product = { productKey:string; category:string; name:string; price:number; description:string; image:string; imageAlt:string; sku?:string; imageWidth?:number; imageHeight?:number; priceNotice?:string; };

interface Props {
  limit?: number;
  showHeading?: boolean;
  productKeys?: string[];
}

const { limit, showHeading = true, productKeys } = Astro.props;
const products = loadSiteProducts(process.cwd(), siteConfig.siteKey) as Product[];
const matching = productKeys ? productKeys.map(key => { const product=products.find(p=>p.productKey===key); if(!product) throw new Error('Unknown selected product '+key); return product; }) : products;
const selected = typeof limit === 'number' ? matching.slice(0, limit) : matching;
const bouquet = selected.filter(p=>p.category==='flower_bouquet');
const basket = selected.filter(p=>p.category==='flower_basket');
const hasGifts = bouquet.length+basket.length>0;
const funeral = selected.filter((p) => p.category === 'funeral_wreath');
const congrats = selected.filter((p) => p.category === 'congrats_wreath');
const money = new Intl.NumberFormat('ko-KR');
---

<section class="product-showcase" aria-label={hasGifts ? "꽃 상품과 가격" : "화환 상품과 가격"}>
  {showHeading && (
    <div class="section-head product-showcase-head">
      <div>
        <span class="eyebrow">상품·가격</span>
        <h2>{siteConfig.region} 꽃배달 {hasGifts ? "상품과 가격" : "대표 화환"}</h2>
        <p class="section-intro">전화주문을 우선 안내하며 온라인 주문은 fwith.co.kr에서 24시간 접수합니다.</p>
      </div>
    </div>
  )}

  {[
    ['근조화환', '고인을 추모하는 마음을 정성껏 전해드립니다.', funeral, 'funeral'],
    ['축하화환', '새로운 시작과 성공을 축하하는 마음을 전합니다.', congrats, 'congrats'],
    ['꽃다발', '약속과 기념일에 손으로 건네는 꽃 선물', bouquet, 'gift'],
    ['꽃바구니', '받은 자리에서 두고 감상하는 꽃 선물', basket, 'gift'],
  ].map(([label, desc, group, tone]) => (
    Array.isArray(group) && group.length > 0 && (
      <div class:list={['product-group', `product-group-${tone}`]}>
        <div class="product-group-head">
          <div>
            <h3>{label}</h3>
            <p>{desc}</p>
          </div>
          {tone !== "gift" && <span>전체보기 ›</span>}
        </div>
        <div class="product-grid">
          {group.map((product) => (
            <article class="product-card" data-product-key={product.sku ? product.productKey : undefined}>
              <div class="product-image-wrap">
                <img
                  src={product.image}
                  alt={product.imageAlt}
                  loading="lazy"
                  decoding="async"
                  width={product.imageWidth || 640}
                  height={product.imageHeight || 640}
                />
              </div>
              <div class="product-card-body">
                <h4>{product.name}</h4>
                <strong class="product-price">{money.format(product.price)}원</strong>
                {product.sku && <p class="product-description">{product.description}</p>}
                {product.sku && <p class="product-price-notice">{product.priceNotice}</p>}
                <div class="product-card-actions">
                  <a href={business.phoneHref}>전화주문</a>
                  <a href={business.onlineOrderUrl} rel="noopener">온라인주문</a>
                </div>
              </div>
            </article>
          ))}
        </div>
      </div>
    )
  ))}

  <div class="product-notices">
    <p>ⓘ {business.productVariationNotice}</p>
    <p>{business.deliveryNotice}</p>
  </div>
</section>
