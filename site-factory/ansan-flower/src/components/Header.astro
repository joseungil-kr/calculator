---
import { siteConfig } from '../config/site';
import business from '../data/business-truth.json';
---
<header class="site-header">
  <div class="container header-row">
    <a class="brand" href="/" aria-label={`${siteConfig.brand} 홈`}>
      <span class="brand-mark" aria-hidden="true"></span>
      <span>{siteConfig.brand}</span>
    </a>
    <nav class="site-nav" aria-label="주요 메뉴">
      {siteConfig.nav.map((item) => <a href={item.href}>{item.label}</a>)}
    </nav>
    <a class="header-cta" href={business.phoneHref} aria-label={`${business.phone} 전화주문`}>
      {business.phone}
    </a>
  </div>
</header>
