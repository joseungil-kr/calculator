---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';

interface Props {
  category: 'guide' | 'places' | 'occasions' | 'flower-knowledge' | 'order-help';
  eyebrow: string;
  title: string;
  intro: string;
  description: string;
  emptyText?: string;
}

const {
  category,
  eyebrow,
  title,
  intro,
  description,
  emptyText = '해당 주제의 상세 가이드를 준비하고 있습니다.',
} = Astro.props;

const articles = (await getCollection(
  'articles',
  ({ data }) =>
    (data.draftStatus === 'approved' || data.draftStatus === 'published') &&
    data.category === category
)).sort((a, b) => a.data.pageKey.localeCompare(b.data.pageKey, 'ko'));

const hrefFor = (article: (typeof articles)[number]) =>
  article.data.routeType === 'top_level'
    ? `/${article.data.slug}/`
    : `/${article.data.category}/${article.data.slug}/`;

const structureLabel: Record<string, string> = {
  hub_overview: '전체 가이드',
  decision_tree: '선택 가이드',
  checklist: '체크리스트',
  etiquette_guide: '문구·예절',
  seasonal_guide: '계절 가이드',
  scenario_based: '상황별',
  recipient_based: '대상별',
  comparison: '비교',
  risk_based: '주의사항',
  route_based: '이동·동선',
  timing_guide: '시간 계획',
  space_based_event: '행사 공간',
  faq_first: '질문 정리',
  care_guide: '관리',
  message_guide: '문구',
  product_form_comparison: '형태 비교',
  myth_busting: '오해 정리',
  relationship_based_b2b: '기업 관계',
};
---
<BaseLayout title={`${title} | 꽃이랑 안산`} description={description}>
  <section class="page-hero">
    <div class="container">
      <span class="eyebrow">{eyebrow}</span>
      <h1>{title}</h1>
      <p>{intro}</p>
    </div>
  </section>

  <section class="section">
    <div class="container">
      {articles.length > 0 ? (
        <div class="hub-card-grid">
          {articles.map((article) => (
            <a class="hub-card" href={hrefFor(article)}>
              <div class="hub-card-top">
                <span class="tag">{structureLabel[article.data.structureType] ?? '가이드'}</span>
                <span class="hub-card-region">{article.data.region}</span>
              </div>
              <h2>{article.data.title}</h2>
              <p>{article.data.description}</p>
              <span class="more">자세히 보기 →</span>
            </a>
          ))}
        </div>
      ) : (
        <div class="notice">{emptyText}</div>
      )}
    </div>
  </section>
</BaseLayout>
