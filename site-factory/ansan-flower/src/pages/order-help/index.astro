---
import BaseLayout from '../../layouts/BaseLayout.astro';
const items = [
  ['체크리스트', '당일 꽃 주문 전에 준비하면 좋은 정보', '받는 사람·장소·시간·문구·연락 담당자를 미리 정리합니다.'],
  ['문구', '회사 이름으로 보내는 축하화환 리본 문구', '대표·부서·회사 명의에 따라 표기 방식을 정리합니다.'],
  ['장례', '근조화환 주문 전 확인해야 할 빈소 정보', '장례식장명, 빈소, 상주, 보내는 사람 정보를 중심으로 봅니다.'],
  ['개업', '화환·화분·꽃바구니 중 무엇이 맞을까요?', '업종과 공간, 받는 사람의 관리 부담을 기준으로 고릅니다.'],
  ['행사', '넓은 행사장으로 보낼 때 주문서에 더 적어야 할 것', '담당자, 설치 위치, 시간대 등 실무 정보를 확인합니다.'],
];
---
<BaseLayout title="꽃 주문 준비 가이드 | 꽃이랑 안산" description="꽃 주문 전 필요한 정보, 문구, 행사장과 장례식장 수령 정보 등을 정리합니다.">
  <section class="page-hero">
    <div class="container">
      <span class="eyebrow">Order Help</span>
      <h1>주문 준비</h1>
      <p>실제 주문을 빠르게 만들기보다, 먼저 빠뜨리기 쉬운 정보를 정리하도록 돕는 페이지입니다.</p>
    </div>
  </section>
  <section class="section">
    <div class="container hub-list">
      {items.map(([kind,title,body]) => (
        <div class="hub-link">
          <span class="kind">{kind}</span>
          <div><strong>{title}</strong><br /><span>{body}</span></div>
          <span class="hub-arrow">준비 중 →</span>
        </div>
      ))}
    </div>
  </section>
</BaseLayout>
