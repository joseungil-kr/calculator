---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import ProductShowcase from '../components/ProductShowcase.astro';
import business from '../data/business-truth.json';

const articles = (await getCollection(
  'articles',
  ({ data }) => data.draftStatus === 'approved' || data.draftStatus === 'published'
)).sort((a, b) => b.data.pageKey.localeCompare(a.data.pageKey, 'ko'));

const recent = articles.slice(0, 6);
const hrefFor = (article: (typeof articles)[number]) =>
  article.data.routeType === 'top_level'
    ? `/${article.data.slug}/`
    : `/${article.data.category}/${article.data.slug}/`;

const trust = [
  ['truck', '전국 배송 가능', '지역별 추가배송비 발생 가능'],
  ['clock', '신속한 주문 접수', '전화 08:00~23:00'],
  ['shield', '화환 반입 여부 확인', '제한 지역은 상담원 문의'],
  ['headset', '전화 상담', '1844-0644'],
];

const situations = [
  { tag: '장례', title: '장례식장 근조화환', body: '빈소 정보와 반입 여부를 먼저 확인합니다.', href: '/order-help/' },
  { tag: '개업·이전', title: '개업·이전 축하화환', body: '매장·사무실·상가 상황별 기준을 정리합니다.', href: '/occasions/' },
  { tag: '병원', title: '병문안 꽃', body: '시설 반입 가능 여부와 상대 상황을 먼저 봅니다.', href: '/places/' },
  { tag: '학교', title: '졸업식 꽃', body: '학교별 이동·보관·전달 기준을 확인합니다.', href: '/places/' },
  { tag: '예식', title: '결혼식 축하화환', body: '예식장 공간과 보내는 명의에 맞춰 선택합니다.', href: '/occasions/' },
  { tag: '화분', title: '화분·식물 가이드', body: '개업·이전 선물용 화분 선택 기준을 정리합니다.', href: '/flower-knowledge/' },
];
---
<BaseLayout>
  <section class="hero hero-commerce">
    <div class="container hero-commerce-grid">
      <div class="hero-copy">
        <span class="hero-badge">안산 전 지역 꽃배달</span>
        <h1>안산 <em>꽃배달</em></h1>
        <p class="hero-lead">소중한 마음을 꽃으로 전하세요.</p>
        <p class="hero-sub">
          근조화환, 축하화환부터 상황별 꽃 선택까지<br />
          안산 꽃배달에 필요한 정보를 한곳에서 확인합니다.
        </p>
        <div class="hero-actions hero-order-actions">
          <a class="hero-phone" href={business.phoneHref}>
            <span>☎</span>
            <strong>전화주문 {business.phone}</strong>
            <small>{business.phoneOrderHours}</small>
          </a>
          <a class="hero-online" href={business.onlineOrderUrl} rel="noopener">
            <span>▣</span>
            <strong>온라인 주문</strong>
            <small>24시간 주문 가능</small>
          </a>
        </div>
      </div>

    </div>
  </section>

  <section class="trust-strip" aria-label="주문 및 배송 안내">
    <div class="container trust-grid">
      {trust.map(([icon, title, desc]) => (
        <div class="trust-item">
          <span class:list={['trust-icon', `trust-icon-${icon}`]} aria-hidden="true"></span>
          <div>
            <strong>{title}</strong>
            <span>{desc}</span>
          </div>
        </div>
      ))}
    </div>
  </section>

  <section class="section product-section">
    <div class="container">
      <ProductShowcase showHeading={false} />
    </div>
  </section>

  <section class="section guide-section">
    <div class="container">
      <div class="section-head simple-head">
        <div>
          <h2>안산에서 많이 찾는 꽃배달</h2>
          <p class="section-intro">장소와 상황이 정해졌다면 필요한 가이드로 바로 이동하세요.</p>
        </div>
      </div>
      <div class="guide-tile-grid">
        {situations.map((item, index) => (
          <a class:list={['guide-tile', `guide-tile-${index + 1}`]} href={item.href}>
            <span>{item.tag}</span>
            <h3>{item.title}</h3>
            <p>{item.body}</p>
            <b>자세히 보기 ›</b>
          </a>
        ))}
      </div>
    </div>
  </section>

  <section class="info-band">
    <div class="container info-band-grid">
      <div><strong>주문 가능 시간</strong><span>전화주문 08:00~23:00 · 온라인 24시간</span></div>
      <div><strong>배송 안내</strong><span>전국 배송 가능 · 지역별 추가배송비 발생 가능</span></div>
      <div><strong>상품 안내</strong><span>지역·계절에 따라 꽃 구성과 형태가 일부 달라질 수 있습니다.</span></div>
      <div><strong>안산 지역별 꽃배달</strong><span>학교·병원·장례식장 등 장소별 상세 가이드 제공</span></div>
    </div>
  </section>

  <section class="section recent-section">
    <div class="container">
      <div class="section-head simple-head">
        <div>
          <h2>최근 공개 가이드</h2>
          <p class="section-intro">새로 발행된 안산 꽃배달 정보를 자동으로 연결합니다.</p>
        </div>
      </div>
      <div class="grid grid-3">
        {recent.map((article) => (
          <a class="card recent-card" href={hrefFor(article)}>
            <div>
              <span class="tag">{article.data.region} · {article.data.category}</span>
              <h3>{article.data.title}</h3>
              <p>{article.data.description}</p>
            </div>
            <span class="more">가이드 읽기 ›</span>
          </a>
        ))}
      </div>
    </div>
  </section>
</BaseLayout>
