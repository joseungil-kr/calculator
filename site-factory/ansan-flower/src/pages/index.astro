---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';

const articles = (await getCollection(
  'articles',
  ({ data }) => data.draftStatus === 'approved' || data.draftStatus === 'published'
)).sort((a, b) => b.data.pageKey.localeCompare(a.data.pageKey, 'ko'));

const recent = articles.slice(0, 6);
const hrefFor = (article: (typeof articles)[number]) =>
  article.data.routeType === 'top_level'
    ? `/${article.data.slug}/`
    : `/${article.data.category}/${article.data.slug}/`;

const situations = [
  { tag: '학교·대학', title: '졸업·입학 꽃', body: '개인 선물인지, 학과·연구실·회사 명의 축하인지부터 구분합니다.', href: '/places/' },
  { tag: '병원', title: '병문안 꽃', body: '향과 크기보다 먼저 시설 반입 가능 여부와 상대의 상황을 확인합니다.', href: '/places/' },
  { tag: '기업·상가', title: '개업·이전 축하', body: '공간, 관계, 보내는 명의를 기준으로 화환·꽃바구니·화분을 비교합니다.', href: '/occasions/' },
  { tag: '장례·조문', title: '위로의 꽃', body: '빈소 정보와 보내는 사람 표기를 먼저 정리한 뒤 문구를 선택합니다.', href: '/order-help/' },
];

const paths = [
  ['1', '상황', '졸업·개업·병문안·조문처럼 꽃이 필요한 이유를 먼저 정합니다.'],
  ['2', '사람', '개인·가족·회사·거래처처럼 받는 사람과 관계를 봅니다.'],
  ['3', '장소', '학교·병원·상가·행사장처럼 수령 장소의 조건을 확인합니다.'],
  ['4', '형태', '꽃다발·꽃바구니·화환·화분 중 전달 방식에 맞는 형태를 비교합니다.'],
];
---
<BaseLayout>
  <section class="hero">
    <div class="container hero-grid">
      <div>
        <span class="eyebrow">안산 로컬 플라워 가이드</span>
        <h1>안산 꽃배달,<br />꽃보다 먼저 기준부터.</h1>
        <p>
          안산에서 꽃을 준비할 때 필요한 것은 지역명만 반복한 추천이 아니라
          누구에게, 어떤 상황에서, 어디로 보내는지에 맞는 판단 기준입니다.
        </p>
        <div class="hero-actions">
          <a class="btn btn-primary" href="/안산꽃배달/">안산 꽃배달 가이드</a>
          <a class="btn btn-ghost" href="/places/">안산 장소별 보기</a>
        </div>
        <div class="hero-proof" aria-label="사이트 운영 원칙">
          <span>확인 가능한 공개자료 우선</span>
          <span>허위 배송후기 없음</span>
          <span>상황별 상세 가이드</span>
        </div>
      </div>
      <div class="hero-art" aria-label="꽃과 줄기를 추상화한 장식 이미지">
        <div class="art-card">
          <strong>오늘의 기준</strong>
          <span>“무슨 꽃이 예쁜가?”보다 “누구에게, 어디서, 어떤 상황인가?”를 먼저 정해보세요.</span>
        </div>
      </div>
    </div>
  </section>

  <section class="section section-tight">
    <div class="container path-strip">
      {paths.map(([n, title, body]) => (
        <div class="path-item">
          <span class="path-num">{n}</span>
          <div><strong>{title}</strong><span>{body}</span></div>
        </div>
      ))}
    </div>
  </section>

  <section class="section">
    <div class="container">
      <div class="section-head">
        <div>
          <span class="eyebrow">상황으로 찾기</span>
          <h2>꽃이 필요한 이유부터 고릅니다.</h2>
          <p class="section-intro">같은 꽃다발도 졸업식과 병문안에서는 판단 기준이 다릅니다.</p>
        </div>
      </div>
      <div class="grid grid-4">
        {situations.map((item) => (
          <a class="card" href={item.href}>
            <div>
              <span class="tag">{item.tag}</span>
              <h3>{item.title}</h3>
              <p>{item.body}</p>
            </div>
            <span class="more">기준 보기 →</span>
          </a>
        ))}
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container decision-box">
      <div>
        <span class="eyebrow">빠른 결정 순서</span>
        <h2>다섯 가지만 먼저 정해도 선택이 쉬워집니다.</h2>
        <p>상세 글은 이 판단 순서에서 필요한 질문 하나씩을 더 깊게 다룹니다.</p>
      </div>
      <div class="decision-list">
        {[
          ['1', '누구에게 보내나요?', '개인, 가족, 회사, 연구실, 거래처처럼 관계를 정합니다.'],
          ['2', '어떤 상황인가요?', '졸업, 개업, 병문안, 조문처럼 목적을 구분합니다.'],
          ['3', '어디에서 받나요?', '학교, 병원, 상가, 행사장 등 장소 특성을 확인합니다.'],
          ['4', '직접 들고 이동하나요?', '꽃 크기와 포장, 보관 시간을 판단합니다.'],
          ['5', '어떤 이름과 문구를 쓰나요?', '개인·회사 명의와 관계의 격식을 맞춥니다.'],
        ].map(([n, title, body]) => (
          <div class="decision-item">
            <span class="decision-num">{n}</span>
            <div><strong>{title}</strong><span>{body}</span></div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <div class="section-head">
        <div>
          <span class="eyebrow">최근 공개 가이드</span>
          <h2>안산에서 실제로 자주 생기는 질문부터.</h2>
          <p class="section-intro">발행된 글은 각 허브에 자동으로 연결되고, 새 글이 추가되면 이 목록도 갱신됩니다.</p>
        </div>
      </div>
      <div class="grid grid-3">
        {recent.map((article) => (
          <a class="card recent-card" href={hrefFor(article)}>
            <div>
              <span class="tag">{article.data.region} · {article.data.category}</span>
              <h3>{article.data.title}</h3>
              <p>{article.data.description}</p>
            </div>
            <span class="more">가이드 읽기 →</span>
          </a>
        ))}
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <div class="notice">
        이 사이트는 확인되지 않은 배송 경험이나 고객후기를 꾸며내지 않습니다.
        시설 반입규정·행사 일정·영업시간처럼 바뀔 수 있는 정보는 가능한 한 공식 자료를 확인한 뒤 안내합니다.
      </div>
    </div>
  </section>
</BaseLayout>
