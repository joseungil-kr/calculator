---
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import MobileOrderBar from '../components/MobileOrderBar.astro';
import '../styles/global.css';
import { siteConfig } from '../config/site';
import buildRevision from '../data/build-revision.json';

interface Props {
  title?: string;
  description?: string;
  canonicalPath?: string;
  ogImage?: string;
  ogImageAlt?: string;
  ogType?: 'website' | 'article';
  robotsOverride?: string;
}

const {
  title = `${siteConfig.brand} | 안산 꽃배달·화환 가격과 지역 가이드`,
  description = siteConfig.description,
  canonicalPath = Astro.url.pathname,
  ogImage = siteConfig.defaultOgImage,
  ogImageAlt = siteConfig.defaultOgImageAlt,
  ogType = 'website',
  robotsOverride,
} = Astro.props;

const origin = Astro.site ?? new URL(siteConfig.siteUrl);
const canonical = new URL(canonicalPath, origin).toString();
const ogImageUrl = new URL(ogImage, origin).toString();
const robots = robotsOverride ?? (siteConfig.indexable ? 'index,follow,max-image-preview:large' : 'noindex,nofollow,noarchive');
const schema = {
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  name: siteConfig.brand,
  url: origin.toString(),
  description,
  inLanguage: 'ko-KR',
};
---
<!doctype html>
<html lang="ko">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="robots" content={robots} />
    <meta name="site-factory-revision" content={buildRevision.sha} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />

    <meta property="og:type" content={ogType} />
    <meta property="og:locale" content="ko_KR" />
    <meta property="og:site_name" content={siteConfig.brand} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImageUrl} />
    <meta property="og:image:alt" content={ogImageAlt} />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageUrl} />
    <meta name="twitter:image:alt" content={ogImageAlt} />

    <script type="application/ld+json" set:html={JSON.stringify(schema)} />
  </head>
  <body>
    <a class="skip-link" href="#main">본문으로 바로가기</a>
    <Header />
    <main id="main">
      <slot />
    </main>
    <Footer />
    <MobileOrderBar />
  </body>
</html>
