{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "ansan-flower-guide-test",
  "compatibility_date": "2026-09-29",
  "workers_dev": false,
  "routes": [
    {
      "pattern": "ansan.fwith.kr",
      "custom_domain": true
    }
  ],
  "assets": {
    "directory": "./dist/",
    "not_found_handling": "404-page",
    "html_handling": "auto-trailing-slash"
  }
}
