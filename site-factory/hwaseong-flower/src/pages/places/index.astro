---
import HubIndex from '../../components/HubIndex.astro';
import { siteConfig } from '../../config/site';
---
<HubIndex category="places" eyebrow="장소별" title={`${siteConfig.region} 장소별 꽃배달`} intro="대학·병원·역·행사장·생활권처럼 실제 목적지가 정해졌을 때 확인해야 할 이동, 수령, 반입, 보관 기준을 정리합니다." description={`대학, 병원, 역, 행사장, 생활권처럼 ${siteConfig.region}의 실제 장소 특성에 맞춰 꽃배달 확인사항을 안내합니다.`} />
